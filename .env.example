# --- Brain -------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
MRX_MODEL=claude-opus-5-5
MRX_EFFORT=medium            # low | medium | high | xhigh | max

# --- Safety ------------------------------------------------------------
# strict   : confirm everything except read-only actions
# balanced : confirm shell commands, deletes, kills, sending/posting  (default)
# trusted  : confirm only deletes, kills, sending/posting
# Sending mail, posting to social media and deleting/killing ALWAYS ask.
MRX_AUTONOMY=balanced

# --- Server ------------------------------------------------------------
MRX_HOST=127.0.0.1
MRX_PORT=8765
# MRX_HOME=~/.mrx

# --- Browser -----------------------------------------------------------
# MRX_BROWSER_HEADLESS=0
# MRX_BROWSER_CDP_URL=http://127.0.0.1:9222   # attach to a Chrome you started with --remote-debugging-port

# --- Email (IMAP/SMTP; use an app password) ----------------------------
# EMAIL_ADDRESS=you@example.com
# EMAIL_PASSWORD=app-password
# EMAIL_IMAP_HOST=imap.gmail.com
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=465
# EMAIL_DRAFTS_FOLDER=[Gmail]/Drafts

# --- Social ------------------------------------------------------------
# MASTODON_BASE_URL=https://mastodon.social
# MASTODON_TOKEN=
# BLUESKY_HANDLE=you.bsky.social
# BLUESKY_APP_PASSWORD=
# X_USER_TOKEN=                 # OAuth2 user-context token (tweet.read tweet.write users.read)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- Media -------------------------------------------------------------
# YOUTUBE_API_KEY=              # optional; search falls back to scraping without it
